{
  "name": "@fileconverter/gui",
  "productName": "FileConverter",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run build --workspace @fileconverter/core && node scripts/dev.mjs",
    "build": "tsc && vite build",
    "package": "npm run build --workspace @fileconverter/core && npm run build && node scripts/stage.mjs && node scripts/package.mjs package",
    "make": "npm run build --workspace @fileconverter/core && npm run build && node scripts/stage.mjs && node scripts/package.mjs make",
    "test": "npm run build --workspace=@fileconverter/core && tsc --noEmit && node --check electron/main.cjs && node --check electron/preload.cjs && node --test test/*.test.cjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@fileconverter/core": "1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "node": "22.23.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  },
  "engines": {
    "node": ">=22.13 <26"
  },
  "version": "1.10.0"
}
