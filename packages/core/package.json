{
  "name": "@fileconverter/core",
  "version": "1.8.1",
  "description": "Universal file conversion CLI and library — images, documents, PDFs, and OCR with pure npm packages",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "converter": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marentius/FileConverter.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Marentius/FileConverter#readme",
  "bugs": {
    "url": "https://github.com/Marentius/FileConverter/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --globals --environment node --testTimeout 30000",
    "test:unit": "vitest run --globals --environment node --testTimeout 30000 test/adapters",
    "test:integration": "vitest run --globals --environment node --testTimeout 30000 test/integration",
    "test:e2e": "vitest run --globals --environment node --testTimeout 30000 test/e2e",
    "test:coverage": "vitest run --globals --environment node --testTimeout 30000 --coverage --coverage.provider=v8 --coverage.reportsDirectory=coverage --coverage.reporter=text --coverage.reporter=lcov --coverage.reporter=html --coverage.include=src/**/*.ts --coverage.exclude=src/**/*.d.ts --coverage.exclude=src/cli.ts",
    "test:watch": "vitest --globals --environment node --testTimeout 30000",
    "test:all": "node test/run-all-tests.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rimraf dist coverage",
    "start": "node dist/cli.js",
    "prepack": "npm run build && npm run test"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@xmldom/xmldom": "^0.8.15",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.3",
    "file-type": "^21.3.2",
    "js-yaml": "^4.3.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "marked": "^17.0.4",
    "officeparser": "^8.0.0",
    "p-queue": "^9.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.530",
    "pdfkit": "^0.19.1",
    "rtf.js": "^3.0.9",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cli-progress": "^3.11.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.0",
    "@types/pdfkit": "^0.17.5",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.0.3",
    "rimraf": "^6.1.3",
    "tsup": "^8.4.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "file-converter",
    "cli",
    "batch",
    "conversion",
    "image",
    "pdf",
    "ocr",
    "sharp",
    "markdown",
    "html"
  ],
  "license": "MIT"
}
