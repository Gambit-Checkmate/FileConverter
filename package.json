{
  "name": "fileconverter",
  "version": "1.6.1",
  "description": "Universal fileconverter with batch support",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install && npm run core:build",
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces",
    "gui:dev": "npm run dev --workspace @fileconverter/gui",
    "gui:build": "npm run package --workspace @fileconverter/gui",
    "core:build": "cd packages/core && npm run build",
    "core:dev": "cd packages/core && npm run dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.0.3",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "overrides": {
    "tar": "7.5.22"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
